# Sanity CMS — Public (exposed to browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=apggi8zn
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity CMS — Server-only

SANITY_API_READ_TOKEN=           # API token with read (viewer) permissions
SANITY_REVALIDATE_SECRET=        # Shared secret for Sanity webhook revalidation
SANITY_PREVIEW_SECRET=           # Shared secret for draft mode preview

# AMPRE / MLS Integration — Server-only
AMPRE_API_BASE_URL=              # AMPRE OData API endpoint
AMPRE_API_TOKEN=                 # Bearer token for AMPRE API
CRON_SECRET=                     # Protects /api/ampre/sync endpoint (auto-set by Vercel Cron)

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Contact Form — Email delivery (Resend)
RESEND_API_KEY=                 # Resend API key (https://resend.com)
RESEND_FROM_EMAIL=              # Verified sender (default: Drenova Group <noreply@drenovagroup.com>)
CONTACT_EMAIL=                  # Inbox for form submissions (default: info@drenovagroup.com)

# Site URL — Used for sitemap and OpenGraph
NEXT_PUBLIC_SITE_URL=           # Production URL (default: https://drenovagroup.com)

KV_REST_API_READ_ONLY_TOKEN=
KV_REST_API_TOKEN=
KV_REST_API_URL=
KV_URL=
REDIS_URL=